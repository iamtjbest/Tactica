name: Weekly Tactical Data Update (BSD)

on:
  schedule:
    # Every Monday 03:00 UTC — BSD has no rate limits so daily is also safe,
    # but weekly is enough; squad data rarely changes mid-week.
    - cron: '0 3 * * 1'
  workflow_dispatch:  # keep manual trigger

jobs:
  update-stats:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: '3.10'

      - name: Install dependencies
        run: |
          python -m pip install --upgrade pip
          pip install requests pandas scikit-learn joblib

      # Step 1 — fetch player squads + stats per team (~140 BSD calls, no limit)
      - name: Fetch player/squad data
        env:
          BSD_API_KEY: ${{ secrets.BSD_API_KEY }}
        run: python auto_updater.py

      # Step 2 — retrain ML model on recent fixture formations
      - name: Retrain ML model
        env:
          BSD_API_KEY: ${{ secrets.BSD_API_KEY }}
        run: python true_ml_model.py

      # Step 3 — commit all updated files in one push
      - name: Commit and push updates
        run: |
          git config --global user.name 'github-actions[bot]'
          git config --global user.email 'github-actions[bot]@users.noreply.github.com'
          git add players.json teams.json tactical_model.pkl
          git diff --staged --quiet || git commit -m "🤖 Weekly BSD update: squads + ML retrain"
          git push
