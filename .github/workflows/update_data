name: Weekly Data Harvester and ML Retrainer

on:
  schedule:
    # Runs exactly once a week (Every Monday morning at 03:00 UTC)
    - cron: '0 3 * * 1'
  workflow_dispatch: # Allows you to trigger this pipeline manually via GitHub UI if needed

jobs:
  harvester_and_retrainer:
    runs-on: ubuntu-latest

    steps:
      - name: Check out Repository Codebase
        uses: actions/checkout@v4

      - name: Set up Python Environment
        uses: actions/setup-python@v5
        with:
          python-python-version: '3.10'
          cache: 'pip'

      - name: Install System Dependencies
        run: |
          python -m pip install --upgrade pip
          if [ -f requirements.txt ]; then pip install -r requirements.txt; fi

      - name: Run BSD Data Synchronization
        env:
          BSD_API_KEY: ${{ secrets.BSD_API_KEY }}
        run: python auto_updater.py

      - name: Retrain Tactical Machine Learning Model
        run: python true_ml_model.py

      - name: Commit and Push Updated Data Matrices
        run: |
          git config --local user.email "actions@github.com"
          git config --local user.name "GitHub Actions Runner"
          git add teams.json players.json tactical_model.pkl
          git diff-index --quiet HEAD || git commit -m "automation: weekly structural squad synchronization [skip ci]"
          git push
