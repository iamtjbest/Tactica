name: Weekly Tactical Data Update

on:
  schedule:
    # Runs WEEKLY on Monday at 03:00 UTC (not daily — saves your API quota)
    - cron: '0 3 * * 1'
  workflow_dispatch: # Keep manual trigger available

jobs:
  update-stats:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout the repository
        uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: '3.10'

      - name: Install Dependencies
        run: |
          python -m pip install --upgrade pip
          pip install requests pandas scikit-learn joblib

      # Step 1: Fetch player stats (uses ~20 API requests)
      - name: Run the Auto-Updater (Player Stats)
        env:
          API_SPORTS_KEY: ${{ secrets.API_SPORTS_KEY }}
        run: python auto_updater.py

      # Step 2: Retrain ML model on fresh fixture data (uses ~21 API requests)
      - name: Run ML Trainer
        env:
          API_SPORTS_KEY: ${{ secrets.API_SPORTS_KEY }}
        run: python true_ml_model.py

      # Step 3: Commit all updated files in one go
      - name: Commit and Push Updated Files
        run: |
          git config --global user.name 'github-actions[bot]'
          git config --global user.email 'github-actions[bot]@users.noreply.github.com'
          git add players.json teams.json tactical_model.pkl
          git diff --staged --quiet || git commit -m "🤖 Weekly auto-update: stats + ML retrain"
          git push
